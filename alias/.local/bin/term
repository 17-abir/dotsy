#!/usr/bin/env bash

# Set current tab title
kitty @ set-tab-title "main-term"

for arg in "$@"; do
  # Resolve the directory using zoxide
  PROJECT_DIR="$(zoxide query "$arg")" || continue

  # Create tab + first pane
  kitty @ launch \
      --no-response \
      --type=tab \
      --tab-title " $arg" \
      --cwd "$PROJECT_DIR"

  # Force grid layout in that tab
  kitty @ goto-layout \
      --match title:"$arg" \
      grid

  # Create second pane
  kitty @ launch \
      --no-response \
      --match title:"$arg" \
      --location=vsplit \
      --cwd "$PROJECT_DIR"
done
