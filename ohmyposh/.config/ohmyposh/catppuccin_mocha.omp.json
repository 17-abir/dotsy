{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
        "os": "#ACB0BE",
        "closer": "p:os",
        "rosewater": "#f5dcdc",
        "flamingo": "#f2cdcd",
        "pink": "#f5c2e7",
        "orange": "#cba6f7",
        "red": "#f38ba8",
        "maroon": "#eaa0eb",
        "peach": "#fab387",
        "yellow": "#f9e2af",
        "green": "#a6e3a1",
        "teal": "#94e2d5",
        "sky": "#89dceb",
        "sapphire": "#74c7ec",
        "blue": "#89b4fa",
        "lavender": "#b4befe",
        "wight": "#FFFFFF",
        "text": "#585b8c",
        "text_red": "#783347",
        "text_green": "#397633",
        "osicon": "#012931"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:green",
    "template": " "
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:text",
          "style": "diamond",
          "leading_diamond": "",
          "template": "󰆥",
          "type": "os"
        },
        {
          "background": "p:text",
          "powerline_symbol": "",
          "style": "powerline",
          "template": "{{.UserName}} ",
          "type": "session"
        },
        {
          "background": "p:blue",
          "foreground": "p:text",
          "powerline_symbol": "",
          "options": {
            "folder_icon": "",
            "home_icon": "",
            "style": "folder"
          },
          "style": "powerline",
          "template": " {{ .Path }} ",
          "type": "path"
        },
        {
          "type": "kubectl",
          "style": "accordion",
          "powerline_symbol": "",
          "foreground": "p:text",
          "background": "p:maroon",
          "template": " 󱃾 {{.Context}}{{if .Namespace}}{{.Namespace}}{{end}} ",
          "options": {
            "context_aliases": {
              "arn:aws:eks:eu-west-1:1234567890:cluster/posh": "posh"
            },
            "cluster_aliases": {
              "arn:aws:eks:eu-west-1:1234567890:cluster/posh": "posh-cluster"
            }
          }
        },
        {
          "background": "p:green",
          "background_templates": [
             "{{ if .Changed }}p:yellow{{ end }}"
          ],
          "foreground": "p:text",
          "powerline_symbol": "",
          "options": {
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "template": " {{ .UpstreamIcon }}{{ trunc 25 .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }}",
          "style": "accordion",
          "type": "git"
        },
        {
          "type": "text",
          "style": "accordion",
          "background": "p:peach",
          "powerline_symbol": "",
          "template": "  "
        },
        {
          "type": "status",
          "style": "diamond",
          "foreground": "p:text",
          "background": "p:blue",
          "background_templates": [
            "{{ if .Error }}p:red{{ end }}"
          ],
          "trailing_diamond": "",
          "template": "  ",
          "options": {
            "always_enabled": true
          }
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "type": "prompt",
      "segments": [
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "p:text",
          "background": "p:lavender",
          "options": {
            "time_format": "15:04"
          }
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "trailing_diamond": "",
          "foreground": "p:text",
          "background_templates": [
            "{{ if gt .Code 0 }}p:red{{ else }}p:green{{ end }}"
          ],
          "background": "p:yellow",
          "template": " {{ .FormattedMs }}",
          "options": {
            "threshold": 500,
            "style": "austin",
            "always_enabled": true
          }
        }
      ]
    },
    {
      "newline": true,
      "alignment": "left",
      "segments": [
        {
          "style": "plain",
          "foreground": "p:green",
          "template": "",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
